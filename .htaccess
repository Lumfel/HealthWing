# HealthWing / VetSystem — Security & Subdirectory-Safe Apache Rules
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    SetEnvIfNoCase X-Forwarded-Proto "https" HW_HTTPS=1
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HW_HTTPS
</IfModule>

# Defense-in-depth denial of VCS and sensitive internal directories even if mod_rewrite is disabled
<IfModule mod_alias.c>
    RedirectMatch 403 (?i)(^|/)\.git(/|$)
    RedirectMatch 403 (?i)(^|/)(includes|database|archives|rate_limit_data|docs)(/|$)
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce HTTPS for external non-local hosts (subdirectory-safe)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
    RewriteCond %{HTTP_HOST} !\.test(:\d+)?$
    RewriteCond %{HTTP_HOST} !^192\.168\.
    RewriteCond %{HTTP_HOST} !^10\.
    RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[0-1])\.
    RewriteCond %{HTTP_X_FORWARDED_PROTO} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block dotfiles (.env, .git, .hw_master_key, .htaccess) and composer manifests
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,NC,L]

    # Block direct browser navigation/download of raw assets, configs, keys, docs, and archives.
    # Gate .css/.js so embedded assets can load while direct document navigation stays blocked.
    RewriteCond %{REQUEST_URI} \.(css|js)$ [NC]
    RewriteCond %{HTTP_SEC_FETCH_DEST} =document [OR]
    RewriteCond %{HTTP_REFERER} ^$
    RewriteRule \.(css|js)$ - [F,NC,L]

    RewriteRule \.(html|htm|map|sql|json|gcm|key|md|bat|sh|env|log)$ - [F,NC,L]

    # Deny sensitive directories even if accessed directly
    RewriteRule ^(archives|docs|includes|database|rate_limit_data)(/|$) - [F,NC,L]

    # Friendly subdirectory-safe routes
    RewriteRule ^calendar/?$ public_calendar.php [L,QSA]
    RewriteRule ^user/?$ owner_bookings.php [L,QSA]
    RewriteRule ^user/book/?$ appointment_schedule.php [L,QSA]
    RewriteRule ^vet/?$ vetindex.php [L,QSA]
    RewriteRule ^signin/?$ login.php [L,QSA]
    RewriteRule ^signup/?$ register.php [L,QSA]
    RewriteRule ^choose-role/?$ choose_role.php [L,QSA]
    RewriteRule ^about/?$ AboutUs.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^receipts/?$ receipts.php [L,QSA]
    RewriteRule ^services/?$ services.php [L,QSA]
    RewriteRule ^services/(wellness|vaccination|dental|surgery|parasite|grooming)/?$ services.php?service=$1 [L,QSA]

    # Extensionless PHP resolution (subdirectory-safe)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
